ngx_addon_name=ngx_http_slowfs_module

HTTP_SLOWFS_SRCS="$ngx_addon_dir/src/ngx_http_slowfs_module.c"

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=$ngx_addon_name
    ngx_module_incs=
    ngx_module_deps=
    ngx_module_srcs="$HTTP_SLOWFS_SRCS"
    ngx_module_libs=

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $HTTP_SLOWFS_SRCS"
fi
